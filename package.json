{
  "name": "django-base-site",
  "description": "Django Base Site",
  "scripts": {
    "dev": "vite --config frontend/config/vite.config.mjs",
    "build": "vite build --config frontend/config/vite.config.mjs",
    "preview": "vite preview --config frontend/config/vite.config.mjs",
    "lint-js": "oxfmt --check ./frontend/ && oxlint --report-unused-disable-directives-severity=error ./frontend/",
    "format-js": "oxfmt ./frontend/ && oxlint --fix ./frontend/",
    "test": "NODE_ENV=test vitest run --config frontend/config/vite.config.mjs"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "openapi-fetch": "^0.17.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epicserve/django-base-site.git"
  },
  "author": "Brent O'Connor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/epicserve/django-base-site/issues"
  },
  "homepage": "https://github.com/epicserve/django-base-site#readme"
}
